/* main.qss - Sidebar Navigation Buttons */
QWidget {
    background: {{bg_primary}};
    color: {{text_primary}};
    font-size: 14px;
}

QMainWindow {
    background: {{bg_primary}};
}

#CentralWidget {
    background: {{bg_primary}};
}

/* ========================================
   SIDEBAR STYLES
   ======================================== */
#Sidebar {
    background: {{bg_secondary}};
    min-width: 240px;
    max-width: 240px;
    border-right: 1px solid {{border_primary}};
}

#Sidebar[collapsed="true"] {
    min-width: 64px;
    max-width: 64px;
}

#SidebarLogo {
    color: {{text_primary}};
    font-size: 20px;
    font-weight: bold;
    padding: 20px;
    letter-spacing: 1px;
    background: transparent;
}

#SidebarToggleButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 12px;
    margin: 4px;
}

#SidebarToggleButton:hover {
    background: {{hover_bg_primary}};
}

#SidebarToggleButton:pressed {
    background: {{active_bg_primary}};
}

/* Navigation Buttons */
QPushButton[class="nav-button"] {
    text-align: left;
    padding: 14px 20px;
    border: none;
    background-color: transparent;
    color: {{text_secondary}};
    font-size: 14px;
    font-weight: 500;
    border-left: 3px solid transparent;
    border-radius: 0px;
}

QPushButton[class="nav-button"]:hover {
    background-color: {{hover_bg_secondary}};
    color: {{hover_text_primary}};
}

QPushButton[class="nav-button"]:checked {
    background-color: {{active_bg_secondary}};
    color: {{active_text_primary}};
    border-left: 3px solid {{border_accent}};
}

QPushButton[class="nav-button"]:checked:hover {
    background-color: {{active_bg_accent}};
}

/* ========================================
   CONTENT AREA
   ======================================== */
#ContentWidget {
    background: {{bg_primary}};
}

#ContentScrollArea {
    background: {{bg_primary}};
    border: none;
}

#ContentScrollArea QScrollBar:vertical {
    background: {{bg_primary}};
    width: 12px;
    border-radius: 6px;
    margin: 0px;
}

#ContentScrollArea QScrollBar::handle:vertical {
    background: {{border_secondary}};
    border-radius: 6px;
    min-height: 30px;
}

#ContentScrollArea QScrollBar::handle:vertical:hover {
    background: {{text_accent}};
}

#ContentScrollArea QScrollBar::add-line:vertical,
#ContentScrollArea QScrollBar::sub-line:vertical {
    height: 0px;
}

#ContentScrollArea QScrollBar::add-page:vertical,
#ContentScrollArea QScrollBar::sub-page:vertical {
    background: transparent;
}

/* ========================================
   HEADER STYLES
   ======================================== */
#Header {
    background: transparent;
    min-height: 60px;
}

#PageTitle {
    font-size: 32px;
    font-weight: bold;
    color: {{text_primary}};
    letter-spacing: -0.5px;
    background: transparent;
}

/* User Actions */
#UserActionsWidget {
    background: transparent;
}

QPushButton[class="action-button"] {
    background: {{bg_secondary}};
    border-radius: 10px;
    font-size: 18px;
    border: none;
    min-width: 44px;
    max-width: 44px;
    min-height: 44px;
    max-height: 44px;
}

QPushButton[class="action-button"]:hover {
    background: {{hover_bg_primary}};
}

QPushButton[class="action-button"]:pressed {
    background: {{active_bg_primary}};
}

/* User Info */
#UserInfoWidget {
    background: transparent;
}

#UserName {
    font-size: 15px;
    font-weight: 600;
    color: {{text_primary}};
    background: transparent;
}

#UserRole {
    font-size: 13px;
    color: {{text_secondary}};
    background: transparent;
}

/* ========================================
   PAGES STACK
   ======================================== */
#PagesStack {
    background: transparent;
}

/* ========================================
   GLOBAL SCROLLBARS
   ======================================== */
QScrollBar:vertical {
    background: {{bg_secondary}};
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: {{border_secondary}};
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: {{text_accent}};
}

QScrollBar:horizontal {
    background: {{bg_secondary}};
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: {{border_secondary}};
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: {{text_accent}};
}

/* ========================================
   COMMON ELEMENTS
   ======================================== */
QPushButton {
    background: {{bg_secondary}};
    color: {{text_primary}};
    border: 1px solid {{border_primary}};
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 14px;
}

QPushButton:hover {
    background: {{hover_bg_primary}};
    border-color: {{border_secondary}};
}

QPushButton:pressed {
    background: {{active_bg_primary}};
}

QPushButton:disabled {
    background: {{bg_secondary}};
    color: {{text_disabled}};
    border-color: {{border_primary}};
}

QLabel {
    background: transparent;
    color: {{text_primary}};
}

/* ========================================
   SIDEBAR BASE
   ======================================== */
#Sidebar {
    background-color: {{bg_secondary}};
    min-width: 240px;
    max-width: 240px;
    border-right: 1px solid {{border_primary}};
}

#Sidebar[collapsed="true"] {
    min-width: 70px;
    max-width: 70px;
}

/* ========================================
   NAVIGATION BUTTONS - BASE STATE
   ======================================== */
QPushButton[class="nav-button"] {
    text-align: left;
    padding: 15px 20px;
    border: none;
    background-color: transparent;
    color: {{text_secondary}};
    font-size: 14px;
    font-weight: 500;
    border-left: 3px solid transparent;
    border-radius: 0px;
}


QPushButton[class="nav-button"]:hover {
    background-color: {{hover_bg_secondary}};
    color: {{hover_text_primary}};
}


QPushButton[class="nav-button"]:checked {
    background-color: {{active_bg_secondary}};
    color: {{active_text_primary}};
    border-left: 3px solid {{border_accent}};
}

/* Active button hover state */
QPushButton[class="nav-button"]:checked:hover {
    background-color: {{active_bg_accent}};
    color: {{active_text_primary}};
}

/* ========================================
   NAVIGATION BUTTONS - PRESSED STATE
   ======================================== */
QPushButton[class="nav-button"]:pressed {
    background-color: {{active_bg_primary}};
    color: {{active_text_primary}};
}

/* ========================================
   SIDEBAR TOGGLE BUTTON
   ======================================== */
#SidebarToggleButton {
    background: transparent;
    border: none;
    text-align: left;
    border-radius: 8px;
    padding: 12px;
    margin: 4px;
}

#SidebarToggleButton:hover {
    background: {{hover_bg_primary}};
}

#SidebarToggleButton:pressed {
    background: {{active_bg_primary}};
}

/* ========================================
   SIDEBAR LOGO
   ======================================== */
#SidebarLogo {
    color: {{text_primary}};
    font-size: 20px;
    font-weight: bold;
    padding: 20px;
    letter-spacing: 1px;
    background: transparent;
}

#ContentScrollArea{
    border: none;
    background: {{bg_primary}};

}

/* ========================================
   HEADER STYLES
   ======================================== */
#Header {
    background: transparent;
    padding: 0px;
}

/* Page Title */
#PageTitle {
    font-size: 32px;
    font-weight: bold;
    color: {{text_primary}};
    letter-spacing: -0.5px;
    background: transparent;
}

/* ========================================
   USER ACTIONS
   ======================================== */
#UserActionsWidget {
    background: transparent;
}

/* Action Buttons (Cart, Messages, Camera, Notifications) */
QPushButton[class="action-button"] {
    background: {{bg_secondary}};
    border-radius: 10px;
    font-size: 18px;
    border: none;
    min-width: 44px;
    max-width: 44px;
    min-height: 44px;
    max-height: 44px;
}

QPushButton[class="action-button"]:hover {
    background: {{hover_bg_primary}};
}

QPushButton[class="action-button"]:pressed {
    background: {{active_bg_primary}};
}

/* Individual button customization if needed */
#ActionButton_Cart,
#ActionButton_Messages,
#ActionButton_Camera,
#ActionButton_Notifications {
    /* Inherits from action-button class */
}

/* ========================================
   USER INFO
   ======================================== */
#UserInfoWidget {
    background: transparent;
}

#UserName {
    font-size: 15px;
    font-weight: 600;
    color: {{text_primary}};
    background: transparent;
}

#UserRole {
    font-size: 13px;
    color: {{text_secondary}};
    background: transparent;
}
/* ========================================
   DASHBOARD PAGE
   ======================================== */
#DashboardPage {
    background: transparent;
}

/* ========================================
   TAB NAVIGATION
   ======================================== */
#TabsWidget {
    background: transparent;
}

QPushButton[class="tab-button"] {
    padding: 10px 24px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    background-color: {{bg_secondary}};
    color: {{text_secondary}};
    border: none;
}

QPushButton[class="tab-button"]:hover {
    background-color: {{hover_bg_primary}};
    color: {{text_primary}};
}

QPushButton[class="tab-button"]:checked {
    background-color: {{active_bg_accent}};
    color: {{active_text_accent}};
}

QPushButton[class="tab-button"]:checked:hover {
    background-color: {{hover_bg_accent}};
    color: {{hover_text_accent}};
}

/* ========================================
   METRIC CARDS
   ======================================== */
#MetricsContainer {
    background: transparent;
}

#MetricCard {
    background: {{bg_secondary}};
    border-radius: 12px;
    border: 1px solid {{border_primary}};
    min-width: 200px;
}

#MetricCard[color="red"] {
    border-left: 4px solid #EF4444;
}

#MetricCard[color="yellow"] {
    border-left: 4px solid #F59E0B;
}

#MetricCard[color="purple"] {
    border-left: 4px solid #8B5CF6;
}

#MetricCard[color="pink"] {
    border-left: 4px solid #EC4899;
}

#MetricTitle {
    font-size: 13px;
    color: {{text_secondary}};
    font-weight: 500;
    background: transparent;
}

#MetricValue {
    font-size: 28px;
    font-weight: bold;
    color: {{text_primary}};
    background: transparent;
}

#MetricArrow {
    font-size: 16px;
    background: transparent;
}

#MetricArrow[direction="up"] {
    color: #10B981;
}

#MetricArrow[direction="down"] {
    color: #EF4444;
}

#MetricChange {
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}

#MetricChange[direction="up"] {
    color: #10B981;
}

#MetricChange[direction="down"] {
    color: #EF4444;
}

#MetricSubtitle {
    font-size: 12px;
    color: {{text_disabled}};
    background: transparent;
}

/* ========================================
   INSIGHTS SECTION
   ======================================== */
#InsightsSection {
    background: transparent;
}

#SectionTitle {
    font-size: 20px;
    font-weight: 600;
    color: {{text_primary}};
    background: transparent;
}

#InsightCard {
    background: {{bg_secondary}};
    border-radius: 12px;
    border: 1px solid {{border_primary}};
    min-width: 200px;
    min-height: 150px;
}

#InsightCard:hover {
    border-color: {{border_accent}};
}

#InsightTitle {
    font-size: 14px;
    font-weight: 600;
    color: {{text_primary}};
    background: transparent;
}

#InsightSubtitle {
    font-size: 12px;
    color: {{text_secondary}};
    background: transparent;
}

#InsightValue {
    font-size: 32px;
    font-weight: bold;
    color: {{text_accent}};
    background: transparent;
}

#InsightChart {
    font-size: 14px;
    color: {{text_secondary}};
    background: transparent;
}

/* ========================================
   PRODUCT & FINANCIAL SECTIONS
   ======================================== */
#ProductSection,
#FinancialSection {
    background: transparent;
}

#ChartCard {
    background: {{bg_secondary}};
    border-radius: 12px;
    border: 1px solid {{border_primary}};
    min-height: 250px;
}

#ChartTitle {
    font-size: 16px;
    font-weight: 600;
    color: {{text_primary}};
    background: transparent;
}

#ChartPlaceholder {
    font-size: 48px;
    color: {{text_disabled}};
    background: {{bg_accent}};
    border-radius: 8px;
    padding: 40px;
}

/* ===================================
   INVENTORY PAGE STYLES
   =================================== */

/* Item List Panel */
QWidget#ItemListPanel {
    background-color: {{bg_secondary}};
    border-right: 1px solid {{border_primary}};
}

QLabel#PanelHeader {
    font-size: 20px;
    font-weight: 700;
    color: {{text_primary}};
    padding: 0;
    margin: 0;
}

/* Search Input */
QLineEdit#SearchInput {
    border: 1px solid {{border_primary}};
    border-radius: 10px;
    padding: 12px 16px;
    background-color: {{bg_accent}};
    color: {{text_primary}};
    font-size: 14px;
}

QLineEdit#SearchInput:focus {
    border: 1px solid {{border_accent}};
    background-color: {{bg_primary}};
}

QLineEdit#SearchInput::placeholder {
    color: {{text_disabled}};
}

/* Filter Buttons */
QPushButton#FilterBtn {
    background-color: {{bg_accent}};
    border: 1px solid {{border_primary}};
    border-radius: 8px;
    padding: 8px 16px;
    color: {{text_secondary}};
    font-weight: 500;
    font-size: 13px;
}

QPushButton#FilterBtn:hover {
    background-color: {{hover_bg_secondary}};
    color: {{hover_text_primary}};
}

QPushButton#FilterBtn[active="true"] {
    background-color: {{active_bg_secondary}};
    color: {{active_text_accent}};
    border-color: {{border_accent}};
}

/* List Widget */
QListWidget#ItemList {
    border: none;
    background-color: transparent;
    outline: none;
}

QListWidget#ItemList::item {
    padding: 0;
    margin-bottom: 8px;
    border: none;
    background-color: transparent;
}

QListWidget#ItemList::item:hover {
    background-color: transparent;
}

QListWidget#ItemList::item:selected {
    background-color: transparent;
}

/* Item List Item Widget - Tab-like Style */
QWidget#ItemListItem {
    background-color: {{bg_accent}};
    border: 1px solid {{border_primary}};
    border-radius: 10px;
    border-left: 3px solid transparent;
}

QListWidget#ItemList::item:hover QWidget#ItemListItem {
    background-color: {{hover_bg_primary}};
    border-color: {{border_secondary}};
    border-left: 3px solid {{border_secondary}};
}

QListWidget#ItemList::item:selected QWidget#ItemListItem {
    background-color: {{active_bg_primary}};
    border: 1px solid {{border_accent}};
    border-left: 4px solid {{border_accent}};
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

QLabel#ItemTitle {
    font-weight: 600;
    font-size: 14px;
    color: {{text_primary}};
}

QLabel#ItemValue {
    font-weight: 600;
    font-size: 13px;
    color: {{text_accent}};
}

QLabel#ItemSubtitle {
    color: {{text_secondary}};
    font-size: 12px;
}

QLabel#ItemStatus {
    color: {{text_secondary}};
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
}

QLabel#ItemStatus[lowstock="true"] {
    color: #F59E0B;
}

QLabel#ItemCount {
    color: {{text_disabled}};
    font-size: 12px;
    padding-top: 8px;
}

/* Detail View Container */
QWidget#DetailViewContainer {
    background-color: {{bg_primary}};
}

/* Main Content */
QWidget#MainContent {
    background-color: {{bg_secondary}};
    border-radius: 16px;
    border: 1px solid {{border_primary}};
}

/* Back Button */
QPushButton#BackBtn {
    font-size: 20px;
    font-weight: 700;
    border: none;
    text-align: left;
    background: transparent;
    color: {{text_primary}};
    padding: 0;
}

QPushButton#BackBtn:hover {
    color: {{text_accent}};
}

/* Actions Container */
QWidget#ActionsContainer {
    background-color: transparent;
}

/* Action Buttons */
QPushButton#ActionBtn {
    background-color: {{bg_accent}};
    border: 1px solid {{border_primary}};
    border-radius: 10px;
    padding: 10px 18px;
    color: {{text_primary}};
    font-weight: 500;
    font-size: 13px;
}

QPushButton#ActionBtn:hover {
    background-color: {{hover_bg_secondary}};
    border-color: {{border_secondary}};
    color: {{hover_text_primary}};
}

QPushButton#ActionBtn:pressed {
    background-color: {{active_bg_primary}};
}

/* Stock Info Bar */
QWidget#StockInfoBar {
    background-color: {{bg_accent}};
    border: 1px solid {{border_primary}};
    border-radius: 12px;
}

QLabel#StockLabel {
    color: {{text_secondary}};
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QLabel#StockValue {
    color: {{text_primary}};
    font-size: 18px;
    font-weight: 700;
}

/* Tabs Container */
QWidget#TabsContainer {
    background-color: transparent;
    border-bottom: 1px solid {{border_primary}};
}

/* Tab Buttons */
QPushButton#TabBtn {
    background-color: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    padding: 14px 20px;
    color: {{text_secondary}};
    font-weight: 600;
    font-size: 14px;
}

QPushButton#TabBtn:hover {
    color: {{hover_text_secondary}};
    background-color: {{hover_bg_primary}};
}

QPushButton#TabBtn[active="true"] {
    color: {{active_text_accent}};
    border-bottom: 3px solid {{border_accent}};
}

/* Content Stack */
QStackedWidget#ContentStack {
    background-color: transparent;
}

/* Pages */
QWidget#DetailsPage,
QWidget#StockPage,
QWidget#UOMPage,
QWidget#BatchPage {
    background-color: transparent;
}

/* Section Widget */
QWidget#SectionWidget {
    background-color: {{bg_accent}};
    border: 1px solid {{border_primary}};
    border-radius: 12px;
}

/* Section Title */
QLabel#SectionTitle {
    font-size: 18px;
    font-weight: 700;
    color: {{text_primary}};
    margin: 0;
    padding: 0;
}

/* Detail Container */
QWidget#DetailContainer {
    background-color: transparent;
}

/* Detail Label */
QLabel#DetailLabel {
    color: {{text_secondary}};
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* Detail Value */
QLabel#DetailValue {
    color: {{text_primary}};
    font-size: 14px;
    font-weight: 500;
}

/* Scroll Content */
QWidget#ScrollContent {
    background-color: transparent;
}

QScrollArea#DetailsScroll {
    border: none;
    background-color: transparent;
}

/* Tables */
QTableWidget#DataTable {
    border: 1px solid {{border_primary}};
    gridline-color: {{border_primary}};
    background-color: {{bg_accent}};
    selection-background-color: {{active_bg_primary}};
    selection-color: {{active_text_primary}};
    border-radius: 12px;
    font-size: 13px;
}

QTableWidget#DataTable::item {
    padding: 12px 16px;
    color: {{text_primary}};
    border-bottom: 1px solid {{border_primary}};
}

QTableWidget#DataTable::item:hover {
    background-color: {{hover_bg_primary}};
}

QTableWidget#DataTable::item:alternate {
    background-color: {{bg_secondary}};
}

QHeaderView::section {
    background-color: {{bg_secondary}};
    padding: 12px 16px;
    border: none;
    border-bottom: 2px solid {{border_primary}};
    font-weight: 700;
    color: {{text_secondary}};
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* Table Action Widget */
QWidget#TableActionWidget {
    background-color: transparent;
}

QPushButton#TableActionBtn {
    background-color: {{bg_primary}};
    border: 1px solid {{border_primary}};
    border-radius: 6px;
    padding: 6px 12px;
    color: {{text_primary}};
    font-weight: 500;
    font-size: 12px;
}

QPushButton#TableActionBtn:hover {
    background-color: {{hover_bg_secondary}};
    color: {{hover_text_primary}};
}

QPushButton#TableDeleteBtn {
    background-color: #7F1D1D;
    border: 1px solid #991B1B;
    border-radius: 6px;
    padding: 6px 12px;
    color: #FEE2E2;
    font-weight: 500;
    font-size: 12px;
}

QPushButton#TableDeleteBtn:hover {
    background-color: #991B1B;
    color: #FFFFFF;
    border-color: #B91C1C;
}

/* Scroll Bars */
QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea#TableScrollArea {
    border: none;
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: {{bg_secondary}};
    width: 12px;
    border-radius: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: {{bg_accent}};
    border-radius: 6px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: {{hover_bg_secondary}};
}

QScrollBar::add-line:vertical, 
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, 
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background-color: {{bg_secondary}};
    height: 12px;
    border-radius: 6px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: {{bg_accent}};
    border-radius: 6px;
    min-width: 30px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: {{hover_bg_secondary}};
}

QScrollBar::add-line:horizontal, 
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, 
QScrollBar::sub-page:horizontal {
    background: none;
}